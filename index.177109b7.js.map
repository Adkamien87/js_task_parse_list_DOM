"use strict";
var list = document.querySelectorAll("li");
var array = [];
function sortList() {
    array = [];
    for(var i = 0; i < list.length; i++){
        var fullName = list[i].innerText;
        var salary = list[i].getAttribute("data-salary");
        var position = list[i].getAttribute("data-position");
        var age = list[i].getAttribute("data-age");
        array.push({
            name: fullName,
            position: position,
            salary: salary,
            age: age
        });
    }
    function salaryConvers() {
        for(var j = 0; j < array.length; j++){
            var salary = array[j].salary.split("");
            salary.shift();
            var newSalary = salary.join("");
            var newSal = newSalary.replace(/,/g, "");
            var sal = Number(newSal);
            array[j].salary = sal;
        }
        array.sort(function(employee1, employee2) {
            return employee2.salary - employee1.salary;
        });
    }
    salaryConvers();
}
function getEmployees() {
    var newLi = document.createElement("li");
    for(var i = 0; i < array.length; i++){
        for(var j = 0; j < list.length; j++)if (list[j].innerText === array[i].name) {
            var ulList = null;
            ulList = document.querySelector("ul");
            newLi = list[j].cloneNode(true);
            ulList.appendChild(newLi);
            list[j].remove();
        }
    }
    return array;
}
sortList();
getEmployees();

